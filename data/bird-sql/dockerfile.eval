FROM python@sha256:a02e9c5406c416c504d6c9a1a306ff4080c3173f1008d192f953bd20382a2d5c AS build

RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libc6-dev
COPY sqlite_clock.c /tmp/sqlite_clock.c
RUN gcc -Wall -Wextra -Werror -O2 -shared -fPIC /tmp/sqlite_clock.c -o /tmp/sqlite-clock.so

FROM python@sha256:a02e9c5406c416c504d6c9a1a306ff4080c3173f1008d192f953bd20382a2d5c
COPY --from=build /tmp/sqlite-clock.so /usr/local/lib/sqlite-clock.so
LABEL org.benchopedia.bird-eval="sqlite-3.40.1-clock-2"
ENV TZ=UTC LD_PRELOAD=/usr/local/lib/sqlite-clock.so
